# Eduvora Platform Foundation Environment Configuration

# Server Setup
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
APP_NAME="Eduvora Core Platform"

# Authentication & Security Secrets
JWT_SECRET=eduvora_super_secret_jwt_key_production_grade_32chars_min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=10

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://eduvora_user:eduvora_secure_pass@localhost:5432/eduvora_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduvora_db
DB_USER=eduvora_user
DB_PASSWORD=eduvora_secure_pass
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Multi-Tenant Settings
DEFAULT_TENANT_HEADER=x-tenant-id
ALLOW_TENANT_QUERY_PARAM=false
SUPER_ADMIN_EMAIL=superadmin@eduvora.com
SUPER_ADMIN_PASSWORD=Eduvora@SuperAdmin2026!

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ais-dev-qwsben7ej2kkkazryfw4bc-89587156417.europe-west2.run.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
